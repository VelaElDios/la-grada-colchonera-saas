# Copia este archivo como .env y rellena los valores (el .env NO se sube al repositorio).
# Aquí solo van los NOMBRES de las variables: nunca escribas valores reales en este fichero.
PORT=3000
# Secreto para firmar la cookie de sesión (obligatorio en producción, mínimo 32 caracteres).
# Para generar uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Las cuentas locales quedan pendientes hasta confirmar el correo. Por defecto: true
# (false solo para pruebas manuales: no cumple el requisito 4.1)
REQUIRE_EMAIL_CONFIRMATION=true
# URL pública de la aplicación (enlaces de los correos y vuelta de OAuth). Vacía = la de cada petición
PUBLIC_URL=
# Correo saliente por SMTP autenticado: smtps://usuario:contraseña@servidor:465
# Si se deja vacía, los correos NO se envían: se escriben en el registro con su enlace (útil en local)
SMTP_URL=
# Remitente de los correos (obligatorio si hay SMTP_URL), p. ej.: La Grada Colchonera <tu-correo@gmail.com>
MAIL_FROM=
# Base de datos PostgreSQL (Neon): postgresql://usuario:contraseña@host/base?sslmode=require
# Si se deja vacía, los datos se guardan en memoria y se pierden al reiniciar
DATABASE_URL=
# Primer administrador: al arrancar se crea esta cuenta (o se promociona si ya existe)
ADMIN_EMAIL=
# Contraseña del primer administrador (mínimo 8 caracteres). Solo se usa si la cuenta no existe
ADMIN_PASSWORD=
# Nivel del registro de actividad: debug, info, warn, error o silent. Por defecto: info
LOG_LEVEL=info
# Dominios de correo permitidos, separados por comas (sin espacios). Ejemplo de valor en producción: uclm.es,alu.uclm.es
ALLOWED_DOMAINS=
