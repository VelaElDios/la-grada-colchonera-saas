# Copia este archivo como .env y rellena los valores (el .env NO se sube al repositorio)
PORT=3000
# Secreto para firmar la cookie de sesión (obligatorio en producción; cadena larga y aleatoria)
SESSION_SECRET=
# true = las cuentas locales quedan pendientes hasta confirmar el correo (Hito 4). Por defecto: false
REQUIRE_EMAIL_CONFIRMATION=false
